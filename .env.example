# Configure uma fonte local de laboratório. Nunca commitar o .env real.
SOURCE_DB_HOST=127.0.0.1
SOURCE_DB_PORT=5432
SOURCE_DB_NAME=esus_demo
SOURCE_DB_USER=esus_demo
SOURCE_DB_PASSWORD=changeme

# Salt usado para pseudonimizar identificadores selecionados (CPF, CNS).
# Gere um valor próprio e mantenha fixo — trocar o salt quebra a
# consistência dos hashes entre execuções.
BRONZE_HASH_SALT=changeme-salt

# Limite de linhas por tabela na extração (vazio = extrai tudo)
INGESTION_ROW_LIMIT=

# Landing zone (parquet bruto, staging antes da conversão pra Delta Lake)
RAW_OUTPUT_DIR=data/raw

# Camadas do Lakehouse (Delta Lake)
LAKEHOUSE_DIR=data/lakehouse
