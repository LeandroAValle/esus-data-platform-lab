# Igual ao .env da raiz, mas com SOURCE_DB_HOST apontando pro host (o
# container do Airflow não enxerga 127.0.0.1 do Windows).
SOURCE_DB_HOST=host.docker.internal
SOURCE_DB_PORT=5432
SOURCE_DB_NAME=esus_demo
SOURCE_DB_USER=esus_demo
SOURCE_DB_PASSWORD=changeme

BRONZE_HASH_SALT=changeme-salt
INGESTION_ROW_LIMIT=1000

RAW_OUTPUT_DIR=data/raw
LAKEHOUSE_DIR=data/lakehouse
